# ---------------------------------------------------------------------------
# Woodin storefront: copy to .env.local and fill in. Never commit .env.local.
# Everything here is SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix) unless noted.
# ---------------------------------------------------------------------------

# WooCommerce STAGING site (a cloned staging copy, never the live woodinfashion.com).
# No trailing slash. Store API is read from {WC_STORE_URL}/wp-json/wc/store/v1
WC_STORE_URL=https://staging.example.com

# Shared secret for the WooCommerce "product updated" webhook -> POST /api/revalidate
REVALIDATE_SECRET=change-me

# When "true", pages render the demo data from the design instead of calling WooCommerce.
USE_DEMO_DATA=true

# Public site URL, used for canonical URLs / metadata (safe to expose).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
