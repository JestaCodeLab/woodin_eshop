# ---------------------------------------------------------------------------
# Woodin storefront: copy to .env.local and fill in. Never commit .env.local.
# Everything here is SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix) unless noted.
# ---------------------------------------------------------------------------

# WooCommerce site. For the pitch this is the LIVE woodinfashion.com, used READ-ONLY
# (catalogue, categories, posts). The live site has no active ecommerce and every
# product price is 0, so cart/checkout must NOT write to it: see WC_ALLOW_CART_WRITES.
# Switch to a cloned staging site when one exists. No trailing slash.
# Store API is read from {WC_STORE_URL}/wp-json/wc/store/v1
WC_STORE_URL=https://cms.woodinfashion.store

# Safety switch: when not "true", /api/cart/* never calls WooCommerce and the app
# uses a local demo cart. Only set to "true" against a staging site.
WC_ALLOW_CART_WRITES=false

# Shared secret for the WooCommerce "product updated" webhook -> POST /api/revalidate
REVALIDATE_SECRET=change-me

# Public site URL, used for canonical URLs / metadata (safe to expose).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production value: NEXT_PUBLIC_SITE_URL=https://shop.woodinfashion.com

# Free-delivery threshold in GH₵ for the announcement bar and the bag progress bar.
# Not confirmed by Woodin: leave unset to show the "[X]" placeholder.
FREE_DELIVERY_THRESHOLD=1500
# Text under "Click & collect" at checkout, e.g. "Ready in 2 hours".
# PICKUP_READY_TEXT=Ready in 2 hours

# Store locations for /stores and the checkout click-and-collect list: a JSON array on ONE line.
# Fields: name, address (required); id, region, phone, gps (GhanaPostGPS), lat + lng (both, for a map pin),
# hours [{label, hours}], services [..], directionsUrl (https only), mapQuery (what Google Maps searches
# for, e.g. "Woodin Boutique - Osu, Oxford St, Accra, Ghana"; defaults to the address). Invalid entries are skipped.
# Region chips and search appear automatically once there are more than 3 stores.
# Unset = two placeholder stores.
STORES_JSON=[{"name":"Store one","region":"Greater Accra","address":"Street, Area, Accra","phone":"0500000000","lat":5.6037,"lng":-0.1870,"hours":[{"label":"Mon – Fri","hours":"9:00am – 7:00pm"},{"label":"Saturday","hours":"10:00am – 6:00pm"}]},{"name":"Store two","region":"Ashanti","address":"Street, Area, Kumasi","phone":"0500000001","lat":6.6885,"lng":-1.6244}]

# Optional: Google Search Console verification token (the content="" value of the meta tag).
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Payments (Paystack + WooCommerce orders). Checkout only takes real payments when
# BOTH Paystack and the orders site are configured; otherwise it runs the simulated demo.
# ---------------------------------------------------------------------------
# Paystack secret key. sk_test_… = test mode (no real money). Never commit it; never prefix NEXT_PUBLIC_.
# An sk_live_… key is ignored (checkout stays simulated) unless PAYSTACK_ALLOW_LIVE=true.
PAYSTACK_SECRET_KEY=
# PAYSTACK_ALLOW_LIVE=true
# Channels shown in the Paystack window (default mobile_money,card).
PAYSTACK_CHANNELS=mobile_money,card
# WooCommerce site that receives the ORDERS (prefer a staging copy). Needs a Read/Write REST API key
# (WooCommerce > Settings > Advanced > REST API). WOOCOMMERCE_CONSUMER_KEY/SECRET also work as names.
WC_ORDERS_URL=https://staging.example.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Safety switch: writing orders to woodinfashion.com is refused unless this is "true".
# WC_ORDERS_ALLOW_LIVE=true
# Paystack dashboard > Settings > API Keys & Webhooks: set the webhook URL to
#   https://shop.woodinfashion.com/api/paystack/webhook

# Social accounts shown in the footer, #WearWoodin and search-engine data. Empty value hides a network.
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/woodinfashion
SOCIAL_FACEBOOK_URL=https://www.facebook.com/woodinfashion
SOCIAL_X_URL=https://twitter.com/woodinafrica
SOCIAL_YOUTUBE_URL=https://www.youtube.com/user/thenationiscoming

# ---------------------------------------------------------------------------
# Order tracking + customer SMS (see PLAN.md section 17)
# ---------------------------------------------------------------------------
# Link template for the carrier's tracking page, with {number}. Unset = the page shows the number only.
# TRACKING_URL_TEMPLATE=https://<ghana-post-tracking-page>?number={number}
# "log" (default) only prints the texts it WOULD send. "flocktext" sends for real through FlockText.
SMS_PROVIDER=log
# FlockText API key (FlockText dashboard > Settings > Developer). Server-side only; never commit it.
FLOCKTEXT_API_KEY=
# Optional: an approved sender ID. Empty = your organisation's primary approved sender ID.
FLOCKTEXT_SENDER_ID=
# Secret for the WooCommerce "Order updated" webhook -> POST /api/woocommerce/webhook (falls back to REVALIDATE_SECRET).
WC_WEBHOOK_SECRET=
